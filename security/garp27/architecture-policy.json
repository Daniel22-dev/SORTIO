    "src/studio-manifest.template.json",
    "src/config/deployment.json",
    "src/config/deployment.school-server.json",
    "src/config/security-headers.json",
    "src/config/data-manifest.json",
    "security/garp27/garp-policy.json",
    "security/garp27/capability-inventory.json",
    "security/garp27/application-migration-profile.json",
    "security/garp27/live-status.json",
    "scripts/garp27/contract-gate.mjs",
    "scripts/garp27/architecture-integrity.mjs",
    "scripts/garp27/policy-admission-mutations.mjs",
    "scripts/garp27/mutation-tests.mjs",
    "scripts/garp27/auto-patch-contract.mjs",
    "scripts/garp27/foundation-gate.mjs"
