{
  "schema": "ghrab-data-manifest-v1",
  "appId": "sortio",
  "appVersion": "1.0.17",
  "manifestVersion": 4,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "lifecycle-state"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-content",
      "patterns": [
        "ghrab.sortio.data.v5",
        "ghrab.sortio.data.v5.last-good",
        "ghrab.sortio.data.v5.pre-import",
        "ghrab.sortio.data.v5.corrupt",
        "ghrab.sortio.data.v4",
        "ghrab.sortio.data.v3",
        "ghrab.sortio.data.v2"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "migration-recovery",
      "patterns": [
        "ghrab.sortio.migration.p2-storage-namespace-v1.backup"
      ],
      "sensitivity": "potentially-personal",
      "authority": "platform-migration",
      "clearOnEndWork": true,
      "notes": "Full migration backup can contain copies of application content and is deleted on suite end."
    },
    {
      "kind": "localStorage",
      "category": "legacy-application-content",
      "patterns": [
        "sortio.data.v5",
        "sortio.data.v5.last-good",
        "sortio.data.v5.pre-import",
        "sortio.data.v5.corrupt",
        "sortio.data.v4",
        "sortio.data.v3",
        "sortio.data.v2"
      ],
      "sensitivity": "potentially-personal",
      "authority": "legacy-runtime",
      "clearOnEndWork": true,
      "notes": "Normally removed by platform migration; suite cleanup detects/removes physical remnants and fails closed if verification is impossible."
    },
    {
      "kind": "localStorage",
      "category": "settings",
      "patterns": [
        "ghrab.sortio.settings.v2",
        "ghrab.sortio.theme.v1"
      ],
      "sensitivity": "non-content-settings",
      "authority": "client-platform",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "lifecycle-state",
      "patterns": [
        "ghrab.sortio.migration.p2-storage-namespace-v1.done",
        "ghrab.sortio.suite-session-state.v1",
        "ghrab.sortio.suite-session-seen.v1"
      ],
      "sensitivity": "non-content-lifecycle",
      "authority": "client-platform",
      "clearOnEndWork": false,
      "notes": "Generation/ack/migration markers contain no application content and must survive cleanup to prevent replay loops."
    },
    {
      "kind": "localStorage",
      "category": "diagnostic-probe",
      "patterns": [
        "__sortio_prod_test__"
      ],
      "sensitivity": "non-content-sentinel",
      "authority": "client",
      "clearOnEndWork": false,
      "ephemeral": true,
      "notes": "Temporary value ok used only by the local storage production self-check and removed immediately."
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-sortio-v*",
        "sortio*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": null,
    "automaticExpiry": false,
    "policy": "persistent-until-user-deletion-or-suite-end-on-shared-device",
    "sessionEndsOnLogout": true,
    "serverLogsDays": null,
    "serverLogging": "not-active-in-standalone-profile"
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [
      "sortio-backup"
    ],
    "nativeFormats": [
      "json",
      "csv",
      "pdf"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "serverEndpoint": null,
    "serverDeletionNotApplicableInPrimaryProfile": true
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "contract": "ghrab-suite-session-v1",
    "control": "GHRAB_PLATFORM.session.onEnd()",
    "acknowledgementKey": "ghrab.sortio.suite-session-seen.v1",
    "applicationLifecycleStateKey": "ghrab.sortio.suite-session-state.v1"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.sortio.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true,
    "rollbackSupportedAfterEndWork": false
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "sortio-backup"
    ],
    "acceptsLegacyJson": true,
    "checksumRequiredForEnvelope": true
  }
}
